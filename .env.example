# ============================================================
#  BẢN MẪU (EXAMPLE) — KHÔNG CHỨA GIÁ TRỊ THẬT
#  Copy file này thành .env rồi điền giá trị thật của bạn.
#  .env đã được .gitignore, an toàn để commit .env.example.
# ============================================================

# ─── Backend ───────────────────────────────────────────────
# Địa chỉ backend REST API
VITE_API_ROOT=http://localhost:8080

# Địa chỉ server Socket.IO (chat realtime)
VITE_SOCKET_URL=http://localhost:8090

# ─── Ứng dụng ─────────────────────────────────────────────
# ID tài khoản admin (đối tác chat bên admin)
VITE_ADMIN_ID=

# ─── Auth ──────────────────────────────────────────────────
# Google Maps API key
VITE_GOOGLE_MAP_API_KEY=

# Auth0 configuration
VITE_DOMAIN_AUTH0=
VITE_CLIENT_ID_AUTH0=

# Google OAuth client ID
VITE_REACT_GOOGLE_CLIENT_ID=

# Facebook App ID (đăng nhập Facebook)
VITE_FACEBOOK_APP_ID=
